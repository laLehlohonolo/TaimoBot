
from fastapi import FastAPI

app = FastAPI(
    title="TaimoBot API",
    description="Paper trading backend for TaimoBot",
    version="0.1.0"
)


@app.get("/")
def home():
    return {
        "application": "TaimoBot",
        "status": "running",
        "mode": "paper_trading",
        "market": "XAUUSD",
        "timezone": "Africa/Johannesburg"
    }


@app.get("/health")
def health_check():
    return {
        "status": "healthy",
        "api": "TaimoBot",
        "trading_mode": "paper"
    }
